# ── Secrets and credentials ─────────────────────────────────────────────
# Never commit these. _scripts/.env contains API keys for SAM.gov,
# Anthropic, Gemini, OpenAI, etc.
_scripts/.env
_scripts/.env.*
!_scripts/.env.example

# ── Python ──────────────────────────────────────────────────────────────
_scripts/.venv/
**/__pycache__/
*.pyc
*.pyo
*.egg-info/

# ── Runtime state files (regenerated each run) ──────────────────────────
_scripts/.find-sources.lock
_meta/sam-quota.json
_meta/usaspending-quota.json

# ── Obsidian per-machine state ──────────────────────────────────────────
# Keep settings, exclude transient pane layout (causes conflicts on sync)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspaces.json

# ── OS noise ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# ── Temporary files ─────────────────────────────────────────────────────
*.tmp
*.bak
*.orig

# ── Trip report audio (binaries + transient processing logs, kept locally only) ──
trip-reports/*/audio/*.m4a
trip-reports/*/audio/*.mp3
trip-reports/*/audio/*.wav
trip-reports/*/audio/*.aac
trip-reports/*/audio/*.log

# HBR PDFs are licensed personal copies — keep local/vault only, do not push to the cloud backup
studies/ai-governance/01_sources/hbr/*.pdf

# ── Private, non-OSI reading area ───────────────────────────────────────
# Proprietary or otherwise non-open-source material that the vault reasons
# FROM but never cites. Nothing here may be pushed. See _private/README.md
# for the crossing rule.
_private/
*.bak[0-9]
