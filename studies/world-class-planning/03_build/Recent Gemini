T_SWBS AS SWBS, Count(1) AS n, Median(SpanEnv) AS MedEnv, Median(SpanLong) AS MedLong, Median(SpanSum) AS MedSum, LINEST_M(SpanEnv , T_EstMD) AS mEnv, LINEST_B(SpanEnv , T_EstMD) AS bEnv, LINEST_M(SpanLong, T_EstMD) AS mLong, LINEST_B(SpanLong, T_EstMD) AS bLong, LINEST_M(SpanSum , T_EstMD) AS mSum, LINEST_B(SpanSum , T_EstMD) AS bSum
