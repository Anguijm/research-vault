    Count(1)                                              AS Phases,
    Count(DISTINCT ICN)                                   AS ICNs,
    Median(Est_MH)                                        AS MedMH,
    Median(PhaseSpan)                                     AS MedSpan,
    Median(ACS - ApplyMap('Map_ICNStart', ICN, ACS))      AS MedOffset
RESIDENT CuPhase_T
