JCN, Est_MD, If($(vCandSWBSSrc)=1, SWBS_A, SWBS_B) AS SWBS, Left(If($(vCandSWBSSrc)=1, SWBS_A, SWBS_B),1) AS SWBS1
RESIDENT Cand_Raw;

