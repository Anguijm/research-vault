// ---------- 3. Sample ICNs, dumped phase by phase ----------
ICN_Size: LOAD ICN, Count(1) AS NP RESIDENT CuPhase_T GROUP BY ICN;
ICN_Sample:
LOAD ICN RESIDENT ICN_Size WHERE NP >= 3 AND NP <= 8;
