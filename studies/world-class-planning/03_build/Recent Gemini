RESIDENT CuPhase_T
WHERE Exists(SampleICN, ICN)
ORDER BY ICN, ACS;

TRACE [sample] ICN | KO | start | end | spanDays | manhours | title;
FOR i = 0 TO NoOfRows('Sample_Phases')-1
