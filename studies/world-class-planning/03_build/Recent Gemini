%JCN_Key AS JCN, \[JB_JCN Est Man Days Qy\] AS Est_MD, Left(\[JB_JCN SWLIN LI ID\], 3) AS SWBS_A, Left(SWLIN_SYS_ID, 3) AS SWBS_B
FROM [lib://QVD-JRMC-AIM/AIM_JB_JCN.qvd] (qvd)

