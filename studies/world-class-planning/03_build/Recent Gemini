    (Max(ACC) - Min(ACS) + 1)                                          AS SpanAll,
    (Max(If(not Match(KO,$(vPlanKO)) and not WildMatch(PhTitle,$(vPlanTitle)), ACC))
       - Min(If(not Match(KO,$(vPlanKO)) and not WildMatch(PhTitle,$(vPlanTitle)), ACS)) + 1) AS SpanProd,
