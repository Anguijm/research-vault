ApplyMap('Map_CuP_JS', CU_PHASE_SA_ID, '(none)') AS JS_Key, JCN_SA_ID
FROM [lib://QVD-JRMC-AIM/ALL_TABLES/JCN_CU_PHASE.qvd] (qvd)

WHERE Exists(CU_PHASE_SA_ID);

