JS_Key AS T_JS, ApplyMap('Map_Dominant_SWBS', JS_Key, '') AS T_SWBS, (Max(ACC) - Min(ACS) + 1) AS SpanEnv, // A: full envelope Max(PhaseSpan) AS SpanLong, // B: longest single phase Sum(PhaseSpan) AS SpanSum, // C: phase-days summed Count(CU_PHASE_SA_ID) AS NPhases, Sum(Est_MH)/$(vHoursPerMD) AS T_EstMD
RESIDENT CuPhase_T

