RESIDENT CuPhase_T GROUP BY JS_Key, SWBS;

JS_Best:

LOAD JS_Key, Max(SWBS_Count) AS BestCount

RESIDENT JS_SWBS_Counts GROUP BY JS_Key;

LEFT JOIN (JS_SWBS_Counts) LOAD JS_Key, BestCount RESIDENT JS_Best;

DROP TABLE JS_Best;

JS_Dom:

